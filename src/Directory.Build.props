<Project>
  <PropertyGroup>
    <Version>1.0.4</Version>
    <Authors>Divsoft Sistemas</Authors>
    <Product>BancoBr.NET</Product>
    <Copyright>Copyright (c) 2023 - Divsoft Sistemas</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>BancoBr;bancos;Brasil;pagamentos;PIX;CNAB240</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl Condition="'$(RepositoryUrl)' == ''">https://github.com/adrianotrentim/bancobr-net</RepositoryUrl>
    <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
	<PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
	<None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../docs/nuget/$(MSBuildProjectName).md" Pack="true" PackagePath="README.md" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
