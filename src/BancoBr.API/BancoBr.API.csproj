<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>BancoBr.API</PackageId>
    <Title>BancoBr.NET — Integração por API</Title>
    <Description>Integração bancária por API para pagamentos, PIX, TED, DDA e extrato, conforme o suporte de cada instituição.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BancoBr.Common\BancoBr.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Testes de mapeamento de wire (PagamentoBoletoClientTests, PagamentoConvenioClientTests)
         instanciam os clients concretos diretamente via o construtor de HttpClient fake. -->
    <InternalsVisibleTo Include="BancoBr.Tests" />
  </ItemGroup>

</Project>
